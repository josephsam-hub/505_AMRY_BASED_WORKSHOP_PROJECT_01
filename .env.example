# Development can use the Vite mock mode by leaving VITE_API_URL empty.
# In production, set these to the central workshop server origin.
VITE_API_URL=
VITE_REALTIME_URL=
VITE_DATA_MODE=production

# Backend / PostgreSQL
DATABASE_URL=postgres://workshop_user:change-me@localhost:5432/workshop
PORT=8080
CORS_ORIGIN=http://localhost:5173
APP_VERSION=0.1.0
